generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  discordId   String   @unique @map("discord_id")
  username    String
  isAdmin     Boolean  @default(false) @map("is_admin")
  isAi        Boolean  @default(false) @map("is_ai")
  createdAt   DateTime @default(now()) @map("created_at")
  displayName String?  @map("display_name")
  avatar      String?

  @@map("users")
}

model ShoppingProduct {
  id           Int                @id @default(autoincrement())
  name         String             @unique
  shoppingList ShoppingListItem[]

  @@map("shopping_products")
}

model ShoppingListItem {
  id        Int             @id @default(autoincrement())
  productId Int             @map("product_id")
  product   ShoppingProduct @relation(fields: [productId], references: [id])

  @@map("shopping_list")
}

model Action {
  id          Int    @id @default(autoincrement())
  name        String @unique
  description String

  @@map("actions")
}

model FeederMotorConfig {
  id         Int     @id @default(autoincrement())
  name       String  @unique
  durationMs Int     @map("duration_ms")
  isDefault  Boolean @default(false) @map("is_default")

  @@map("feeder_motor_configs")
}

model FeederLightConfig {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  durationSec Int     @map("duration_sec")
  isDefault   Boolean @default(false) @map("is_default")

  @@map("feeder_light_configs")
}

model FeederSettings {
  id                         Int     @id @default(autoincrement())
  motionNotificationsEnabled Boolean @default(true) @map("motion_notifications_enabled")

  @@map("feeder_settings")
}

model HomeTemp {
  id          Int      @id @default(autoincrement())
  tempInside  Float    @map("temp_inside")
  tempOutside Float    @map("temp_outside")
  humidity    Float
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("home_temp")
}
